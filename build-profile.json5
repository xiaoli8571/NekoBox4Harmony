{
  "app": {
    // 仓库基线必须保持空签名段(见 AGENTS.md「注意事项」)。
    // 本机要出签名包时由 scripts/inject-signing.js 写入,注入后的改动**不要提交**;
    // 还原基线:node scripts/inject-signing.js --profile build-profile.json5 --reset。
    // 提交本机证书路径会让其他机器因找不到证书文件而构建失败(此坑已踩过一次)。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "externalNativeOptions": {
            "path": "./entry/src/main/cpp/CMakeLists.txt",
            "arguments": "",
            "cppFlags": "",
            "abiFilters": [
              "arm64-v8a"
            ]
          }
        },
        "targetSdkVersion": "6.1.1(24)"
      }
    ],
    // ⚠️ 出包必须带 `-p buildMode=release`(见 scripts/build-and-sign.sh)。
    // 漏掉时 hvigor 按 debug 产出,产物 module.json 里是
    // "buildMode":"debug" + "debug":true —— 就算签名用的确实是发布证书也一样,
    // AppGallery 会以「经检测为debug版本」退回(《审核指南》3.5,2026-09-27 踩过)。
    // 别被 signingConfigs[].type 误导:那是「平台」(HarmonyOS/OpenHarmony),
    // 与构建模式无关;要 release 得靠这个 buildModeSet + 命令行 -p。
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
