Allow injecting an already-open TUN file descriptor into sing-box 1.5 via
environment variables.  On OpenHarmony the TUN device can only be created by
the system through @ohos.net.vpnExtension (the app sandbox has no access to
/dev/net/tun), so the fd obtained from vpnConnection.create() is inherited by
the sing-box child process and handed to sing-tun here.

SING_BOX_TUN_FD   numeric fd of the platform TUN (required, > 0)
SING_BOX_TUN_NAME optional interface name to report in logs

sing-tun v0.1.16 treats a non-zero Options.FileDescriptor as
"use this fd directly and skip all netlink setup", which is exactly what we
want: route/address configuration is performed by the OS VPN framework.

--- a/inbound/tun.go
+++ b/inbound/tun.go
@@ -3,6 +3,7 @@
 import (
 	"context"
 	"net"
+	"os"
 	"strconv"
 	"strings"
 
@@ -142,6 +143,17 @@ func (t *Tun) Start() error {
 	if t.tunOptions.Name == "" {
 		t.tunOptions.Name = tun.CalculateInterfaceName("")
 	}
+	if t.tunOptions.FileDescriptor == 0 {
+		if fdStr := os.Getenv("SING_BOX_TUN_FD"); fdStr != "" {
+			if fd, fdErr := strconv.Atoi(fdStr); fdErr == nil && fd > 0 {
+				t.tunOptions.FileDescriptor = fd
+				if tunName := os.Getenv("SING_BOX_TUN_NAME"); tunName != "" {
+					t.tunOptions.Name = tunName
+				}
+				t.logger.Info("using platform tun file descriptor ", fd)
+			}
+		}
+	}
 	var (
 		tunInterface tun.Tun
 		err          error
